DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=penmozhi_db
# Optional: full URL (Railway may inject DATABASE_URL / MYSQL_URL / MYSQL_PUBLIC_URL)
# Prefer linking the MySQL service so MYSQLHOST=*.railway.internal is used.
# DATABASE_URL=
# MYSQL_URL=
# MYSQL_PUBLIC_URL=

JWT_SECRET_KEY=super-secret-key-change-me-32bytes!
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
FLASK_DEBUG=True
FLASK_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLIENT_APP_URL=http://localhost:3000

# Optional SMTP for password reset emails (if unset, DEBUG mode returns token in API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# LLM (AI assistant) — provider: auto | gemini | anthropic
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Web Push (VAPID keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@penmozhi.com

# Scheduled push notifications (set true in production worker, not debug reloader)
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=15

# Wearable OAuth stubs — TODO: configure per provider
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Payment stubs — TODO: real payment integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
